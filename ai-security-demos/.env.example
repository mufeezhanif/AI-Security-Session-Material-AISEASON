# Groq (OpenAI-compatible). Get a key: https://console.groq.com/keys
GROQ_API_KEY=gsk-your-key-here

# OpenAI-compatible base URL for Groq (do not change unless self-hosting)
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Chat model (Groq). Default used by demos if unset.
GROQ_MODEL=llama-3.3-70b-versatile
# Fast/cheap model for classifiers/guardrails
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Moderation / safety model on Groq (used as the guardrail in demo-4)
GROQ_GUARD_MODEL=meta-llama/llama-guard-4-12b

# NOTE: Groq has NO embeddings endpoint and NO moderation endpoint.
#   - Embeddings (demo-2, demo-6): run locally via chromadb's default
#     sentence-transformers model (all-MiniLM-L6-v2). No API key needed.
#   - Moderation (demo-4): use Llama Guard on Groq (GROQ_GUARD_MODEL above).

# --- Optional, used by later demos ---

# demo-4 / demo-8: target FastAPI chat URL
# CHAT_URL=http://127.0.0.1:8000/chat

# Optional third-party guard / tracing keys (no-op when absent)
# LAKERA_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
