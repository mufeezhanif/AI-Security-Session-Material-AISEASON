# Groq only — no OpenAI key. https://console.groq.com/keys
GROQ_API_KEY=gsk-your-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# demo-4 AFTER endpoint (promptfoo + live pytest)
CHAT_URL=http://127.0.0.1:8001/chat

# monitor.py denial-of-wallet teaching thresholds
TOKEN_SPIKE_THRESHOLD=2000
COST_PER_1K_TOKENS=0.05
COST_SPIKE_USD=0.10
