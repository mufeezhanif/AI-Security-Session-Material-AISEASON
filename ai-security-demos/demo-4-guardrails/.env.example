# Groq (OpenAI-compatible). https://console.groq.com/keys
GROQ_API_KEY=gsk-your-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
# Llama Guard — input/output safety (Groq has no Moderation API)
GROQ_GUARD_MODEL=meta-llama/llama-guard-4-12b

# replay.py targets
BEFORE_URL=http://127.0.0.1:8000/chat
AFTER_URL=http://127.0.0.1:8001/chat
